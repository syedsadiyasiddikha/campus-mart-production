          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "save_to_wishlist",
        "title": "Save to wishlist",
        "description": "Add a Campus Mart listing to the signed-in student's wishlist.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "productId": {
              "type": "string",
              "description": "Listing id to save."
            }
          },
          "required": [
